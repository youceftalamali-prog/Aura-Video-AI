{
  "name": "aura-video-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "description": "Aura Video AI - Enterprise SaaS for AI-powered advertising video generation",
  "scripts": {
    "dev": "pnpm run --parallel dev",
    "dev:api": "pnpm --filter @aura/api dev",
    "dev:web": "pnpm --filter @aura/web dev",
    "dev:admin": "pnpm --filter @aura/admin dev",
    "build": "pnpm run -r build",
    "build:api": "pnpm --filter @aura/api build",
    "build:web": "pnpm --filter @aura/web build",
    "build:admin": "pnpm --filter @aura/admin build",
    "lint": "pnpm run -r lint",
    "typecheck": "pnpm --filter @aura/types build && pnpm --filter @aura/config build && pnpm --filter @aura/shared build && pnpm --filter @aura/ui build && pnpm --filter @aura/sdk build && pnpm run -r typecheck",
    "db:generate": "pnpm --filter @aura/api db:generate",
    "db:migrate": "pnpm --filter @aura/api db:migrate",
    "db:push": "pnpm --filter @aura/api db:push",
    "db:studio": "pnpm --filter @aura/api db:studio",
    "clean": "pnpm run -r clean && rm -rf node_modules"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "prettier": "^3.3.3",
    "eslint": "^10.8.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
