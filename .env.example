# Active billing provider: PayPal (Stripe dormant)
# ===========================================
# Aura Video AI - Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values

# Node
NODE_ENV=development
PORT=3001

# Database (PostgreSQL)
DATABASE_URL=postgresql://aura:aura_secret@localhost:5432/aura_video_ai
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=aura:

# JWT
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# Frontend URLs
WEB_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
API_URL=http://localhost:3001

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aura-assets
R2_PUBLIC_URL=
R2_ENDPOINT=

# Optional: Fall back to local storage in development
STORAGE_PROVIDER=local
# STORAGE_PROVIDER=r2
LOCAL_STORAGE_PATH=./storage

# App
APP_NAME=Aura Video AI
APP_VERSION=0.1.0
SUPPORT_EMAIL=support@auravideo.ai

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Credits (default for new users)
DEFAULT_CREDITS=50

# AI Provider (OpenAI-compatible)
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.3
AI_TIMEOUT_MS=60000
AI_RATE_LIMIT_MAX=20

# Media / Video generation
MEDIA_PROVIDER=none
# Implemented media providers: openai only. fal|runway|kling|veo|google → VIDEO_PROVIDER_NOT_IMPLEMENTED. none → VIDEO_PROVIDER_DISABLED.
MEDIA_API_KEY=
MEDIA_BASE_URL=
MEDIA_TIMEOUT_MS=120000
VIDEO_MAX_DURATION=60
VIDEO_MAX_SCENES=20
VIDEO_RATE_LIMIT_MAX=10

MEDIA_VIDEO_MODEL=sora-2

# Text-to-Speech
TTS_PROVIDER=openai
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=tts-1
TTS_DEFAULT_VOICE=alloy

PRODUCT_ANALYSIS_CREDITS=0
PRODUCT_ANALYSIS_ENABLED_BILLING=false

# Publishing / Social OAuth
TOKEN_ENCRYPTION_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
META_CLIENT_ID=
META_CLIENT_SECRET=
META_REDIRECT_URI=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
PUBLISHING_RATE_LIMIT_MAX=30

# Billing (optional — top-up fails with BILLING_PROVIDER_NOT_CONFIGURED if empty)
STRIPE_SECRET_KEY=
BILLING_PROVIDER_API_KEY=

# Stripe (DORMANT — DO NOT CONFIGURE FOR ACTIVE BILLING; PayPal is active)
# Stripe (Phase 12) — leave empty to get BILLING_PROVIDER_NOT_CONFIGURED
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_CREDITS_SMALL=
STRIPE_PRICE_CREDITS_MEDIUM=
STRIPE_PRICE_CREDITS_LARGE=
STRIPE_SUCCESS_URL=http://localhost:5173/billing/success
STRIPE_CANCEL_URL=http://localhost:5173/billing/cancel

# PayPal (Phase 12 — active billing provider)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_STARTER_PLAN_ID=
PAYPAL_PRO_PLAN_ID=
PAYPAL_BUSINESS_PLAN_ID=
PAYPAL_CURRENCY=USD
PAYPAL_CREDITS_SMALL_VALUE=9.99
PAYPAL_CREDITS_MEDIUM_VALUE=39.99
PAYPAL_CREDITS_LARGE_VALUE=99.99
PAYPAL_SUCCESS_URL=http://localhost:5173/billing/success
PAYPAL_CANCEL_URL=http://localhost:5173/billing/cancel
