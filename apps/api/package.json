{
  "name": "@aura/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker": "tsx src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test:security": "tsx scripts/security-deterministic-test.ts",
    "test:ai-gateway": "tsx scripts/ai-gateway-deterministic-test.ts",
    "test:product-intelligence": "tsx scripts/product-intelligence-deterministic-test.ts",
    "test:runtime": "tsx scripts/runtime-infrastructure-test.ts",
    "test:video-asset": "tsx scripts/video-asset-integrity-deterministic-test.ts",
    "test:credits": "tsx scripts/credit-ledger-deterministic-test.ts",
    "test:storage": "tsx scripts/storage-ffmpeg-deterministic-test.ts",
    "test:library": "tsx scripts/library-deterministic-test.ts",
    "test:billing": "tsx scripts/billing-deterministic-test.ts",
    "test:paypal": "tsx scripts/paypal-deterministic-test.ts",
    "test:production": "tsx scripts/production-readiness-deterministic-test.ts",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aura/config": "workspace:*",
    "@aura/shared": "workspace:*",
    "@aura/types": "workspace:*",
    "@aws-sdk/client-s3": "^3.1110.0",
    "@aws-sdk/s3-request-presigner": "^3.1110.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "stripe": "^22.5.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.26.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
